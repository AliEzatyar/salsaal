
upstream django_app{
    server unix:/code/uwsgi_app.sock;
}

server {
    listen 80;
    server_name  shop.ahmadyar.pro 127.0.0.1 hello.com ;
    return 301 https://$host$request_uri;
}

server{
    listen 443 ssl;
    ssl_certificate /code/salsaal.crt;
    ssl_certificate_key /code/salsaal.key ;
    server_name shop.ahmadyar.pro 127.0.0.1 hello.com;
    error_log stderr warn;
    access_log /dev/stdout main;

    location / {
        include /etc/nginx/uwsgi_params;
        uwsgi_pass django_app;
    }
    location /static/ {
        alias /code/project/static_/;
    }

    location /media/ {
        alias /code/project/media/;
    }
    client_max_body_size 5M;
}